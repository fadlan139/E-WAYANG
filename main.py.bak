ROOT = Path(__file__).resolve().parent
ASSETS = ROOT / "assets"
AUDIO = ROOT / "audio"
CONFIG = json.loads((ROOT / "config.json").read_text(encoding="utf-8"))
STORY = json.loads((ROOT / "story.json").read_text(encoding="utf-8"))

